# Copiar a .env y completar. NUNCA subir el .env al repositorio.

# Subdominio del chatbot (debe apuntar con un registro DNS A a la IP del servidor)
DOMINIO_BOT=bot.quixagroup.com

# Dominios desde los que se puede usar el chat, separados por coma
QUIXA_ORIGENES=https://quixagroup.com,https://www.quixagroup.com

# Generar con: openssl rand -hex 24   (y guardarlas en un gestor de contraseñas)
POSTGRES_PASSWORD=
# Generar con: openssl rand -hex 32   — si se pierde, las credenciales guardadas en n8n no se pueden leer
N8N_ENCRYPTION_KEY=

# Límites anti-abuso (RNF-04)
QUIXA_MAX_MENSAJES_SESION=30
QUIXA_MAX_CARACTERES=1000
QUIXA_MAX_MENSAJES_IP_HORA=120
QUIXA_MINUTOS_INACTIVIDAD=30

# Correo al consultor (RF-08) y enlace a la ficha completa
QUIXA_CORREO_CONSULTOR=
QUIXA_URL_VISOR=
